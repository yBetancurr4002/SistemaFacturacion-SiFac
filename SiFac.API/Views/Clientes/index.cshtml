@model IEnumerable<SiFac.DAL.Entidades.Cliente>

<h2 class="mb-4">Lista de Clientes</h2>

<!-- Tabla con estilos de Bootstrap -->
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th scope="col">Nombre</th>
            <th scope="col">NIT</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Persona?.Nombre</td>
                <td>@c.Nit</td>
                <td>
                    <!-- Botones de acción con estilos de Bootstrap -->
                    <a asp-action="Detalle" asp-route-id="@c.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-warning btn-sm ms-2">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@c.Id" class="btn btn-danger btn-sm ms-2">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Botón para crear un nuevo cliente -->
<a asp-action="Crear" class="btn btn-primary">Nuevo Cliente</a>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar este cliente?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <a id="deleteButton" class="btn btn-danger">Eliminar</a>
            </div>
        </div>
    </div>
</div>

<!-- Script para manejar el modal -->
<script>
    document.querySelectorAll('.btn-danger').forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();
            const deleteUrl = this.getAttribute('href');
            const modal = document.getElementById('confirmDeleteModal');
            const deleteButton = document.getElementById('deleteButton');
            
            // Asignar la URL de eliminación al botón del modal
            deleteButton.setAttribute('href', deleteUrl);
            
            // Mostrar el modal
            const modalInstance = new bootstrap.Modal(modal);
            modalInstance.show();
        });
    });
</script>